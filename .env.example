# Neon DEVELOPMENT branch: pooled application connection (-pooler hostname).
DATABASE_URL=""

# Direct connection to the SAME development branch for Prisma migrations.
DIRECT_URL=""

# Auth.js: generate a random secret and configure a GitHub OAuth application.
# Local callback URL: http://localhost:3000/api/auth/callback/github
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional single-IP header OVERWRITTEN by your trusted reverse proxy.
# Leave empty unless direct access is blocked and the proxy strips client values.
# Without it, a shared request budget and per-account limits still apply.
AUTH_TRUSTED_IP_HEADER=""

# Resend: use a sender on your verified domain.
# Set exactly false to skip emails and reminders; unset defaults to enabled.
# Restart the server or redeploy after changing this server-only setting.
EMAIL_VERIFICATION_ENABLED=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# Trusted public origin for verification and billing return URLs.
# Billing also accepts AUTH_URL when APP_URL is empty. Use HTTPS outside loopback.
APP_URL=""

# Supabase Storage only. Server-only values: never prefix with NEXT_PUBLIC_.
# Project URL (not a database connection string or /storage/v1 endpoint).
SUPABASE_URL=""
# Dashboard > Settings > API Keys > Secret keys (sb_secret_...).
SUPABASE_SECRET_KEY=""
# Name of a private Storage bucket created in the Dashboard.
SUPABASE_STORAGE_BUCKET=""
# Protects the retryable storage cleanup endpoint (Vercel Cron sends this bearer).
CRON_SECRET=""

# Stripe server-only configuration.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY_ID=""
STRIPE_PRICE_YEARLY_ID=""
# Optional dedicated Portal configuration for DevStash.
STRIPE_PORTAL_CONFIGURATION_ID=""
# Set to true only after live billing validation. Sandbox Checkout does not require this.
STRIPE_LIVE_CHECKOUT_ENABLED=""
